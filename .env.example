# Copy to .env for local development, or define the same keys in Infisical (dev/prod).
# Process environment overrides .env when both are set.

# Provider API keys (required for the active LLM_PROVIDER only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LLM_PROVIDER: openai | anthropic | gemini | mock (default: openai)
LLM_PROVIDER=

# LLM_MODEL (default: gpt-4o-mini; per-provider defaults apply if unset)
LLM_MODEL=

# APP_ENV (default: development)
APP_ENV=

# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: DEBUG)
LOG_LEVEL=
